{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "rotes",
    "version": "0.1.0",
    "identifier": "xyz.taxi0k.rotes",
    "build": {
        "beforeDevCommand": "npm run dev",
        "devUrl": "http://localhost:1420",
        "beforeBuildCommand": "npm run build",
        "frontendDist": "../dist"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "rotes",
                "width": 800,
                "height": 600,
                "minWidth": 625,
                "minHeight": 200
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
